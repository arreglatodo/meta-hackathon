# Meta Model API key (https://dev.meta.ai). Required in Vercel and locally.
# In the Claude Code cloud sandbox it is injected by the outbound proxy.
MODEL_API_KEY=

# Optional override of the Meta Model API base URL.
# META_BASE_URL=https://api.meta.ai/v1

# Private configuration (never commit values; see docs/DATA-POLICY.md).
# Hours calibration from calibration/hours.sql, as JSON. Empty = demo values.
HOMEPLAN_HOURS_CALIBRATION=
# Rates per zone and fee brackets, as JSON. Empty = demo values.
HOMEPLAN_PRICING=

# Cleaning providers shown in the carousel, with their own rates per zone, as JSON.
# Empty = synthetic demo providers.
HOMEPLAN_PROVIDERS=

# WhatsApp number (digits only) that receives bookings from the quote page.
NEXT_PUBLIC_BOOKING_WHATSAPP=
